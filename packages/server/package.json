{
    "name": "@taim/server",
    "private": true,
    "type": "module",
    "exports": {
        "./rpc": {
            "types": "./src/routers/index.ts"
        },
        "./schema": {
            "types": "./src/db/schema.ts"
        }
    },
    "scripts": {
        "--development--": "",
        "dev": "FORCE_COLOR=1 bun --watch src/index.ts",
        "build": "bun build src/index.ts --target bun --outdir ../../dist/server",
        "start": "NODE_ENV=production bun ../../dist/server/index.js",
        "--checks--": "",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "--database--": "",
        "db:push": "bun --bun drizzle-kit push",
        "db:studio": "bun --bun drizzle-kit studio",
        "db:generate": "bun --bun drizzle-kit generate",
        "db:migrate": "bun --bun drizzle-kit migrate"
    },
    "dependencies": {
        "@clerk/hono": "0.1.90",
        "@hono/bun": "1.0.1",
        "@t3-oss/env-core": "0.13.11",
        "chalk": "5.6.2",
        "drizzle-orm": "0.45.2",
        "hono": "4.13.13",
        "neverthrow": "8.2.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@libsql/client": "0.18.0",
        "@types/bun": "1.4.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "drizzle-kit": "0.31.10",
        "eslint": "10.8.1",
        "typescript": "6.0.3",
        "vitest": "5.0.5",
        "@taim/eslint": "workspace:*"
    }
}
