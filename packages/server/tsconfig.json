{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "paths": {
            "@web/*": ["../web/src/*"],
            "@server/*": ["./src/*"],
            "@test/*": ["../test/src/*"]
        }
    },
    "include": ["src", "drizzle.config.ts", "vitest.config.ts"]
}
