{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"],
        "paths": {
            "@web/*": ["../web/src/*"],
            "@server/*": ["../server/src/*"],
            "@test/*": ["./*"]
        }
    },
    "include": [
        "*.ts",
        "platform-support/**/*.ts",
        "serenity/**/*.ts",
        "setup/**/*.ts",
        "spec/**/*.ts"
    ]
}
