{
    "name": "@taim/test",
    "private": true,
    "type": "module",
    "scripts": {
        "--checks--": "",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
        "test": "FORCE_COLOR=1 bun --env-file=.env run playwright test --pass-with-no-tests",
        "test:headed": "FORCE_COLOR=1 bun --env-file=.env run playwright test --headed --pass-with-no-tests",
        "test:ui": "FORCE_COLOR=1 bun --env-file=.env run playwright test --ui",
        "--tooling--": "",
        "browsers:install": "playwright install chromium"
    },
    "devDependencies": {
        "@clerk/testing": "2.2.50",
        "@playwright/test": "1.64.1",
        "@serenity-js/assertions": "3.49.0",
        "@serenity-js/console-reporter": "3.49.0",
        "@serenity-js/core": "3.49.0",
        "@serenity-js/html-reporter": "3.49.0",
        "@serenity-js/playwright": "3.49.0",
        "@serenity-js/playwright-test": "3.49.0",
        "@serenity-js/rest": "3.49.0",
        "@serenity-js/web": "3.49.0",
        "@t3-oss/env-core": "0.13.11",
        "@taim/eslint": "workspace:*",
        "@taim/server": "workspace:*",
        "@types/node": "26.6.4",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "10.8.1",
        "typescript": "6.0.3",
        "zod": "4.4.3"
    }
}
