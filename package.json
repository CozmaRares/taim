{
    "name": "taim",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "--development--": "",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "start": "turbo run start --filter=@taim/server",
        "--checks--": "",
        "check": "turbo run lint typecheck",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "typecheck": "turbo run typecheck",
        "knip": "SKIP_ENV_VALIDATION=true knip",
        "test": "turbo run test --log-order=stream",
        "test:force": "turbo run test --force --log-order=stream",
        "--tooling--": "",
        "format": "turbo run lint:fix && prettier --write .",
        "lint-staged": "lint-staged",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "bun scripts/lint-staged-eslint.ts",
            "prettier --write"
        ],
        "**/*.{json,jsonc,md,css,html,yml,yaml}": "prettier --write"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "@types/node": "26.6.5",
        "husky": "9.1.7",
        "knip": "6.24.0",
        "lint-staged": "17.6.0",
        "prettier": "3.8.3",
        "prettier-plugin-tailwindcss": "0.8.1",
        "turbo": "2.11.10",
        "typescript": "6.0.3"
    }
}
