{
    "name": "taim",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "--development--": "",
        "dev": "bun run --parallel --filter '*' dev",
        "build": "bun run --parallel --filter '*' build",
        "start": "bun run --filter @taim/server start",
        "--checks--": "",
        "check": "bun run --parallel lint typecheck",
        "lint": "bun run --parallel --filter '*' lint",
        "lint:fix": "bun run --parallel --filter '*' lint:fix",
        "typecheck": "bun run --parallel --filter '*' typecheck",
        "knip": "SKIP_ENV_VALIDATION=true knip",
        "test": "bun run --parallel --filter '*' test",
        "--tooling--": "",
        "format": "bun run --parallel --filter '*' lint:fix && prettier --write .",
        "lint-staged": "lint-staged",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "bun scripts/lint-staged-eslint.ts",
            "prettier --write"
        ],
        "**/*.{json,jsonc,md,css,html,yml,yaml}": "prettier --write"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "@types/node": "26.6.5",
        "husky": "9.1.7",
        "knip": "6.24.0",
        "lint-staged": "17.6.0",
        "prettier": "3.8.3",
        "prettier-plugin-tailwindcss": "0.8.1",
        "typescript": "6.0.3"
    }
}
