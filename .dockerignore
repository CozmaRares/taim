# Only send files used by the Dockerfile.
**
!package.json
!bun.lock
!turbo.json
!packages/
!packages/*/
!packages/*/package.json
!packages/server/src/
!packages/server/src/**
!packages/server/tsconfig.json
!packages/server/drizzle/
!packages/server/drizzle/**
!packages/server/drizzle.config.ts
!packages/web/src/
!packages/web/src/**
!packages/web/build/
!packages/web/build/**
!packages/web/public/
!packages/web/public/**
!packages/web/index.html
!packages/web/tsconfig.json
!packages/web/vite.config.ts

# Tests and local artifacts stay out even when colocated with source.
**/node_modules
**/_test
**/__tests__
**/__mocks__
**/*.test.*
**/*.spec.*
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/.cache
**/*.tsbuildinfo
